# Production listener. A non-loopback address requires both TLS files.
SNAPLINK_STRIPE_LISTEN=0.0.0.0:8443
SNAPLINK_STRIPE_TLS_CERT_FILE=/etc/snaplink-stripe/tls/tls.crt
SNAPLINK_STRIPE_TLS_KEY_FILE=/etc/snaplink-stripe/tls/tls.key

# Durable adapter-owned inbox and checkout/provider-id mapping store.
SNAPLINK_STRIPE_POSTGRES_DSN=postgres://snaplink_stripe:replace-me@postgres.example.com/snaplink_stripe?sslmode=verify-full

# Snaplink resource-server validation for the checkout API.
SNAPLINK_STRIPE_ISSUER=https://sso.example.com
SNAPLINK_STRIPE_JWKS_URL=https://sso.example.com/.well-known/jwks.json
SNAPLINK_STRIPE_AUDIENCE=https://stripe-adapter.example.com

# Least-privilege machine bridge to snaplink-billing.
SNAPLINK_STRIPE_BILLING_BASE_URL=https://billing.example.com
SNAPLINK_STRIPE_TOKEN_URL=https://sso.example.com/token
SNAPLINK_STRIPE_BILLING_RESOURCE=https://billing.example.com
SNAPLINK_STRIPE_BINDINGS_FILE=/etc/snaplink-stripe/bindings/bindings.json
SNAPLINK_STRIPE_ACME_BILLING_SECRET=replace-with-secret-manager-value

# Stripe mode, account, and webhook API version are exact event bindings.
# Use account=platform for direct platform requests/events or one exact acct_*
# id; connected-account Checkout requests carry that id in Stripe-Account.
SNAPLINK_STRIPE_API_BASE_URL=https://api.stripe.com
SNAPLINK_STRIPE_API_VERSION=2025-06-30.basil
SNAPLINK_STRIPE_LIVE_MODE=true
SNAPLINK_STRIPE_ACCOUNT=platform
SNAPLINK_STRIPE_WEBHOOK_API_VERSION=2025-06-30.basil
SNAPLINK_STRIPE_API_KEY=rk_live_replace_with_restricted_key
SNAPLINK_STRIPE_WEBHOOK_SECRETS=whsec_replace_with_current,whsec_replace_with_next

# Exact origins only; paths supplied by callers may vary within these origins.
SNAPLINK_STRIPE_RETURN_ORIGINS=https://console.example.com

SNAPLINK_STRIPE_HTTP_TIMEOUT=10s
SNAPLINK_STRIPE_HANDLER_TIMEOUT=25s
SNAPLINK_STRIPE_READY_TIMEOUT=2s
SNAPLINK_STRIPE_POLL_INTERVAL=1s
SNAPLINK_STRIPE_CLAIM_LEASE=45s
SNAPLINK_STRIPE_SHUTDOWN_DRAIN=50s
SNAPLINK_STRIPE_BATCH_SIZE=50
SNAPLINK_STRIPE_DELIVERY_CONCURRENCY=8
SNAPLINK_STRIPE_MAX_BACKLOG=10000
SNAPLINK_STRIPE_MAX_BACKLOG_AGE=15m

# Set true only for loopback-only local development URLs.
SNAPLINK_STRIPE_ALLOW_INSECURE_LOOPBACK=false
