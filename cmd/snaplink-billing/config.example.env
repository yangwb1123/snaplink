# The service itself is plaintext and therefore loopback-only. Put a trusted
# same-host or same-Pod TLS edge in front of it.
SNAPLINK_BILLING_LISTEN=127.0.0.1:8090
SNAPLINK_BILLING_ISSUER=https://sso.example.com
SNAPLINK_BILLING_JWKS_URL=https://sso.example.com/.well-known/jwks.json
SNAPLINK_BILLING_AUDIENCE=https://billing.example.com

# Secret-bearing values are environment-only. Replace every placeholder.
SNAPLINK_BILLING_POSTGRES_DSN=postgres://billing:REPLACE_ME@postgres.example.com/billing?sslmode=verify-full
SNAPLINK_BILLING_POSTGRES_MAX_OPEN=20
SNAPLINK_BILLING_POSTGRES_MAX_IDLE=5
SNAPLINK_BILLING_POSTGRES_CONN_MAX_LIFETIME=30m
SNAPLINK_BILLING_POSTGRES_CONN_MAX_IDLE_TIME=5m

# Empty means no startup catalog seed. The file must contain a strict Plan array.
SNAPLINK_BILLING_CATALOG_FILE=

# Optional desired-state machine client -> tenant/source bindings. See the
# adjacent source-bindings.example.json; an empty value leaves the durable
# binding table under external operator control.
SNAPLINK_BILLING_SOURCE_BINDINGS_FILE=

# Automatic subscription settlement is deliberately opt-in. When enabled,
# every process owner must be unique; empty derives hostname-PID automatically.
SNAPLINK_BILLING_RENEWALS_ENABLED=false
SNAPLINK_BILLING_RENEWALS_OWNER=
SNAPLINK_BILLING_RENEWALS_INTERVAL=1m
SNAPLINK_BILLING_RENEWALS_LEASE=2m
SNAPLINK_BILLING_RENEWALS_RETRY_DELAY=1h
SNAPLINK_BILLING_RENEWALS_BATCH_SIZE=50

# Empty base URL disables both durable Audit Governance relay workers.
SNAPLINK_BILLING_AUDIT_BASE_URL=https://audit.example.com
SNAPLINK_BILLING_AUDIT_TOKEN_URL=https://sso.example.com/token
SNAPLINK_BILLING_AUDIT_CLIENT_ID=snaplink-relay
SNAPLINK_BILLING_AUDIT_CLIENT_SECRET=REPLACE_ME
# Optional strict {"revision":N,"enabled":bool} desired state. SIGHUP applies
# only a strictly newer revision; credentials and endpoint remain cold.
SNAPLINK_BILLING_AUDIT_RUNTIME_FILE=
# Every tenant source is derived as this prefix plus a SHA-256 identifier.
SNAPLINK_BILLING_AUDIT_SOURCE_PREFIX=snaplink-billing
SNAPLINK_BILLING_AUDIT_SCOPE=audit:event:write
SNAPLINK_BILLING_AUDIT_RESOURCE=audit-governance
SNAPLINK_BILLING_RELAY_OWNER=REPLACE_WITH_UNIQUE_POD_NAME
SNAPLINK_BILLING_AUDIT_HTTP_TIMEOUT=5s
SNAPLINK_BILLING_AUDIT_AUTH_PAUSE=1m
SNAPLINK_BILLING_AUDIT_ERROR_PAUSE=5s

# Empty base URL disables entitlement-to-SSO quota projection. This OAuth
# credential is distinct from Audit Governance and payment-adapter clients.
SNAPLINK_BILLING_QUOTA_BASE_URL=https://sso.example.com
SNAPLINK_BILLING_QUOTA_TOKEN_URL=https://sso.example.com/token
SNAPLINK_BILLING_QUOTA_CLIENT_ID=snaplink-billing-quota-relay
SNAPLINK_BILLING_QUOTA_CLIENT_SECRET=REPLACE_WITH_DISTINCT_SECRET
SNAPLINK_BILLING_QUOTA_SOURCE_PREFIX=snaplink-billing-quota
SNAPLINK_BILLING_QUOTA_SCOPE=tenant-quota:projection:write
SNAPLINK_BILLING_QUOTA_RESOURCE=snaplink-sso-quota
SNAPLINK_BILLING_QUOTA_RELAY_OWNER=REPLACE_WITH_UNIQUE_POD_NAME
SNAPLINK_BILLING_QUOTA_HTTP_TIMEOUT=5s
SNAPLINK_BILLING_QUOTA_LEASE=30s
SNAPLINK_BILLING_QUOTA_BATCH_SIZE=100
SNAPLINK_BILLING_QUOTA_INITIAL_BACKOFF=1s
SNAPLINK_BILLING_QUOTA_MAX_BACKOFF=1m
SNAPLINK_BILLING_QUOTA_POLL_INTERVAL=500ms
SNAPLINK_BILLING_QUOTA_MAX_LAG=5m
SNAPLINK_BILLING_QUOTA_ERROR_PAUSE=5s
SNAPLINK_BILLING_READY_TIMEOUT=3s
