# OIDC Conformance Test Suite Configuration
# ==========================================
#
# Loaded by `docker compose --env-file config.env up` and injected into the
# conformance-suite container via env_file. Values here mirror the defaults
# in docker-compose.yml; keep them in sync.

# --- Server Under Test (browser-reachable URL; the container URL is fixed
# by the compose network and must NOT be overridden here) ---
SSO_ISSUER=http://localhost:8180

# --- Conformance Suite ---
CONFORMANCE_SERVER_EXTERNAL_URL=http://localhost:8080
CONFORMANCE_SSO_SERVER=http://sso-server:8080
CONFORMANCE_SSO_DISCOVERY=http://sso-server:8080/.well-known/openid-configuration

# --- Test Plan ---
# Comma-separated list of test modules to run. ONLY the modules listed in
# README.md's supported-profile table may be selected; the runtime accepts
# response_type code + direct-mint token, so implicit and hybrid OP modules
# must never be enabled.
CONFORMANCE_TEST_PLANS=basic,config,dynamic,formpost,session,logout

# --- Database ---
CONFORMANCE_DB_HOST=conformance-db
CONFORMANCE_DB_PORT=5432
CONFORMANCE_DB_NAME=conformance
CONFORMANCE_DB_USER=conformance
CONFORMANCE_DB_PASSWORD=conformance
