# OIDC Conformance Test Suite Configuration
# ==========================================
#
# This file is sourced by docker compose when running the conformance
# test suite. Override values in the environment to customise.
#
# The server-under-test is assumed to be at http://sso-server:8080
# within the conformance-net Docker network, and at http://localhost:8180
# from the host (where the conformance browser accesses it).

# --- Server Under Test ---
SSO_ISSUER=http://localhost:8180
SSO_STORAGE=sqlite
SSO_SIGNUP_ENABLED=true
SSO_DCR_ENABLED=true
SSO_ALLOW_OPEN_REGISTRATION=true

# --- Conformance Suite ---
CONFORMANCE_SERVER_EXTERNAL_URL=http://localhost:8080
CONFORMANCE_SSO_SERVER=http://sso-server:8080
CONFORMANCE_SSO_DISCOVERY=http://sso-server:8080/.well-known/openid-configuration

# --- Test Plan ---
# Comma-separated list of test modules to run:
# basic,implicit,hybrid,config,dynamic,formpost,session,logout,ciba,jarm,fapi
CONFORMANCE_TEST_PLANS=basic,implicit,config,dynamic

# --- Database ---
CONFORMANCE_DB_HOST=conformance-db
CONFORMANCE_DB_PORT=5432
CONFORMANCE_DB_NAME=conformance
CONFORMANCE_DB_USER=conformance
CONFORMANCE_DB_PASSWORD=conformance
