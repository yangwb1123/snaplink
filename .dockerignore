# Keep generated artifacts and local credentials out of every Docker build
# context. Source, module files and .git remain available to the builder so
# version metadata keeps its existing behavior.
/bin/
/dist/
/logs/
/.venv/
/.pytest_cache/
/.pi/
/sdks/rust/target/
/sdks/python/build/
/sdks/python/*.egg-info/
/sdks/build/
/sdks/*/build/
/sdks/.gradle/
**/node_modules/
**/.build/
**/.swiftpm/
/ops/deploy/openresty/fullstack/static/
/test/oidc-conformance/results/
**/__pycache__/
*.py[cod]
*.cover
*.prof
*.test
*.out
coverage.*
/coverage.out
/coverage.html
/snaplink-billing
/snaplink-stripe-adapter
/sso-server
/sso-minimal
/sso-ctl
/gensdk
/ops/deploy/compose/secrets/
/ops/deploy/baremetal-ha/secrets/
**/.env
**/.env.*
!**/.env.example
