{
  "$schema": "./capability.schema.json",
  "schema_version": 1,
  "availability_classes": [
    "sdk",
    "stock-binary",
    "standalone-binary",
    "module-only",
    "external-frontend"
  ],
  "default_states": [
    "enabled",
    "disabled",
    "conditional",
    "external"
  ],
  "feature_gates": [
    "admin_api",
    "branding",
    "oidc",
    "ciba",
    "caep",
    "federation",
    "self_service",
    "web_spa"
  ],
  "capabilities": [
    {
      "id": "admin.control-plane",
      "name": "Admin control plane",
      "summary": "Scoped administration, governance, audit and lifecycle APIs.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "conditional",
      "feature_gate": "admin_api",
      "required_stores": ["AdminTokenStore"],
      "module_capabilities": ["admin.control-plane.v1"],
      "config_keys": ["feature_gates.admin_api", "admin"],
      "surfaces": ["/api/v1/admin/*"],
      "sources": ["interfaces/sso/server_routes_admin.go"]
    },
    {
      "id": "api.docs-viewer",
      "name": "Embedded API docs viewer",
      "summary": "Admin-gated self-contained viewer for the committed OpenAPI contract.",
      "availability": ["sdk"],
      "default_state": "disabled",
      "feature_gate": "admin_api",
      "required_stores": [],
      "module_capabilities": [],
      "config_keys": [],
      "surfaces": ["/api/v1/admin/docs"],
      "sources": ["interfaces/apidocs"]
    },
    {
      "id": "audit.governance-provisioner",
      "name": "Audit Governance desired-state provisioner",
      "summary": "Create-only reconciliation of tenant, source allow-list and schema desired state against Audit Governance.",
      "availability": ["standalone-binary"],
      "default_state": "disabled",
      "feature_gate": null,
      "required_stores": ["Audit Governance control API"],
      "module_capabilities": [],
      "config_keys": ["SNAPLINK_AUDIT_PROVISIONER_MANIFEST_FILE", "SNAPLINK_AUDIT_PROVISIONER_BASE_URL"],
      "surfaces": ["/livez", "/readyz", "/metrics", "Audit Governance control API"],
      "sources": ["cmd/snaplink-audit-provisioner"]
    },
    {
      "id": "audit.kafka",
      "name": "Kafka audit sink",
      "summary": "Fail-open delivery of structured audit events to Kafka.",
      "availability": ["stock-binary", "module-only"],
      "default_state": "disabled",
      "feature_gate": null,
      "required_stores": [],
      "module_capabilities": ["audit.sink.kafka.v1"],
      "config_keys": ["audit.kafka"],
      "surfaces": ["audit sink"],
      "sources": ["infrastructure/kafka/snaplink.module.json"]
    },
    {
      "id": "authorization.fga",
      "name": "Fine-grained authorization",
      "summary": "Relationship tuples, graph expansion and authorization checks.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "disabled",
      "feature_gate": null,
      "required_stores": ["RebacStore", "RebacEngine"],
      "module_capabilities": ["platform.authorization.v1"],
      "config_keys": ["rebac"],
      "surfaces": ["/authz/*"],
      "sources": ["platform/lifecycle/rebac"]
    },
    {
      "id": "branding.public",
      "name": "Public tenant branding",
      "summary": "Per-host public branding metadata for independently deployed frontends.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "conditional",
      "feature_gate": "branding",
      "required_stores": ["TenantStore"],
      "module_capabilities": ["platform.tenant.v1"],
      "config_keys": ["feature_gates.branding", "tenant"],
      "surfaces": ["/branding"],
      "sources": ["interfaces/sso/server_me.go"]
    },
    {
      "id": "caep.shared-signals",
      "name": "CAEP and Shared Signals",
      "summary": "Security event streams, SET transmission and fail-closed SET reception.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "disabled",
      "feature_gate": "caep",
      "required_stores": ["CAEPStreamStore", "JTIReplayStore"],
      "module_capabilities": ["platform.threat.v1"],
      "config_keys": ["caep", "feature_gates.caep"],
      "surfaces": ["/.well-known/ssf-configuration", "/ssf/*"],
      "sources": ["protocols/caep"]
    },
    {
      "id": "ciba.core",
      "name": "OpenID Connect CIBA",
      "summary": "Backchannel authentication with poll, ping and push delivery modes.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "disabled",
      "feature_gate": "ciba",
      "required_stores": ["CIBAStore"],
      "module_capabilities": ["oauth.advanced.v1"],
      "config_keys": ["ciba", "feature_gates.ciba"],
      "surfaces": ["/backchannel-authentication", "/token"],
      "sources": ["protocols/oauth/handle_ciba.go"]
    },
    {
      "id": "cluster.ha",
      "name": "Cluster and HA coordination",
      "summary": "Cross-replica invalidation, shared state and topology readiness.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "disabled",
      "feature_gate": null,
      "required_stores": ["cluster.Bus", "shared durable stores"],
      "module_capabilities": ["cluster.ha.v1"],
      "config_keys": ["cluster", "topology"],
      "surfaces": ["/readyz", "cross-replica bus"],
      "sources": ["cmd/sso-server/build_app_cluster.go"]
    },
    {
      "id": "commerce.tenant",
      "name": "Tenant commerce and billing",
      "summary": "Versioned plans, snapshotted subscription renewal, entitlement projections, wallets, top-up orders, normalized payment-event ingestion, durable SSO quota delivery and optional Audit Governance retention projection.",
      "availability": ["sdk", "standalone-binary"],
      "default_state": "conditional",
      "feature_gate": null,
      "required_stores": ["commerce.Store", "commerce.PaymentStore", "commerce.RenewalStore"],
      "module_capabilities": ["commerce.tenant.v1"],
      "config_keys": ["SNAPLINK_BILLING_RENEWALS_ENABLED", "SNAPLINK_BILLING_QUOTA_BASE_URL", "SNAPLINK_BILLING_RETENTION_BASE_URL"],
      "surfaces": ["/api/v1/admin/commerce/*", "/api/v1/commerce/*/payments/*", "/readyz", "/metrics"],
      "sources": ["domains/tenant/commerce", "interfaces/commerce", "interfaces/ssoclient/quotaprojection", "infrastructure/postgres/tenantcommerce", "cmd/snaplink-billing"]
    },
    {
      "id": "federation.openid",
      "name": "OpenID Federation",
      "summary": "Federation entity, trust-chain resolution and home-realm discovery.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "disabled",
      "feature_gate": "federation",
      "required_stores": ["FederationEntity"],
      "module_capabilities": ["federation.openid.v1"],
      "config_keys": ["federation", "feature_gates.federation"],
      "surfaces": ["/.well-known/openid-federation*", "/auth/home-realm"],
      "sources": ["domains/federation"]
    },
    {
      "id": "frontend.admin",
      "name": "Admin console",
      "summary": "Operator-facing administration application deployed independently.",
      "availability": ["external-frontend"],
      "default_state": "external",
      "feature_gate": null,
      "required_stores": [],
      "module_capabilities": [],
      "config_keys": [],
      "surfaces": ["/admin/*"],
      "sources": ["docs/deployment.md"]
    },
    {
      "id": "frontend.developer",
      "name": "Developer portal",
      "summary": "Client and integration developer application deployed independently.",
      "availability": ["external-frontend"],
      "default_state": "external",
      "feature_gate": null,
      "required_stores": [],
      "module_capabilities": [],
      "config_keys": [],
      "surfaces": ["/developer/*"],
      "sources": ["docs/deployment.md"]
    },
    {
      "id": "frontend.login",
      "name": "Hosted login",
      "summary": "Browser login and consent application deployed independently.",
      "availability": ["external-frontend"],
      "default_state": "external",
      "feature_gate": null,
      "required_stores": [],
      "module_capabilities": [],
      "config_keys": [],
      "surfaces": ["/login/*"],
      "sources": ["docs/deployment.md"]
    },
    {
      "id": "frontend.self-service",
      "name": "Self-service portal",
      "summary": "End-user account, session and device application deployed independently.",
      "availability": ["external-frontend"],
      "default_state": "external",
      "feature_gate": null,
      "required_stores": [],
      "module_capabilities": [],
      "config_keys": [],
      "surfaces": ["/portal/*"],
      "sources": ["docs/deployment.md"]
    },
    {
      "id": "frontend.setup",
      "name": "Setup application",
      "summary": "First-run configuration application deployed independently.",
      "availability": ["external-frontend"],
      "default_state": "external",
      "feature_gate": null,
      "required_stores": [],
      "module_capabilities": [],
      "config_keys": [],
      "surfaces": ["/setup/*"],
      "sources": ["docs/deployment.md"]
    },
    {
      "id": "identity.enterprise-auth",
      "name": "Enterprise authenticators",
      "summary": "SAML, LDAP, Kerberos and RADIUS enterprise authentication integrations.",
      "availability": ["module-only"],
      "default_state": "disabled",
      "feature_gate": null,
      "required_stores": [],
      "module_capabilities": ["identity.enterprise-auth.v1"],
      "config_keys": [],
      "surfaces": ["/auth/saml/*", "/auth/kerberos", "Authenticator SPI"],
      "sources": ["ops/build/modules.json"]
    },
    {
      "id": "identity.mfa",
      "name": "MFA and passkeys",
      "summary": "Step-up MFA, enrollment, recovery codes and WebAuthn authentication.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "conditional",
      "feature_gate": null,
      "required_stores": ["MFAChallengeStore", "MFAEnrollmentStore"],
      "module_capabilities": ["identity.security.v1"],
      "config_keys": ["mfa", "authenticators.webauthn"],
      "surfaces": ["/auth/mfa", "/me/mfa/*", "/webauthn/*"],
      "sources": ["interfaces/sso/server_mfa.go"]
    },
    {
      "id": "identity.password",
      "name": "Password authentication",
      "summary": "Local password authentication with policy, history and lockout controls.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "enabled",
      "feature_gate": null,
      "required_stores": ["UserProvider", "PasswordCredentialStore"],
      "module_capabilities": ["authenticator.password.v1"],
      "config_keys": ["authenticators.password", "password_policy"],
      "surfaces": ["/auth/login"],
      "sources": ["cmd/sso-server/serverbuildauthn/build_authenticators.go"]
    },
    {
      "id": "identity.self-service",
      "name": "Identity self-service APIs",
      "summary": "Profile, session, device, consent, MFA and account lifecycle APIs.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "conditional",
      "feature_gate": "self_service",
      "required_stores": ["UserProvider", "feature-specific stores"],
      "module_capabilities": ["identity.self-service.v1"],
      "config_keys": ["self_service", "feature_gates.self_service"],
      "surfaces": ["/me/*", "/sessions/me/*", "/consents/me/*"],
      "sources": ["interfaces/sso/sso_selfservice.go"]
    },
    {
      "id": "keys.lifecycle",
      "name": "Signing-key lifecycle",
      "summary": "Rotation, overlap, retirement, peer adoption and readiness enforcement.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "conditional",
      "feature_gate": null,
      "required_stores": ["signing key Registry"],
      "module_capabilities": ["signing.lifecycle.v1"],
      "config_keys": ["keys"],
      "surfaces": ["/.well-known/jwks.json", "/readyz"],
      "sources": ["platform/signingkeys"]
    },
    {
      "id": "metering.usage",
      "name": "Machine usage and entitlement API",
      "summary": "Invoice-grade usage facts, atomic reservations, client-bound dimensions and narrow entitlement reads.",
      "availability": ["sdk", "standalone-binary"],
      "default_state": "conditional",
      "feature_gate": null,
      "required_stores": ["usageledger.Store", "usageledger.SourceBindingStore", "commerce.EntitlementReader"],
      "module_capabilities": [],
      "config_keys": ["SNAPLINK_BILLING_SOURCE_BINDINGS_FILE"],
      "surfaces": ["/api/v1/metering/usage", "/api/v1/metering/reservations*", "/api/v1/metering/entitlement"],
      "sources": ["domains/metering/usageledger", "interfaces/metering", "infrastructure/postgres/usageledger", "cmd/snaplink-billing"]
    },
    {
      "id": "oauth.advanced",
      "name": "Advanced OAuth security",
      "summary": "PAR, JAR, DPoP, mTLS, RAR, token exchange and FAPI controls.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "conditional",
      "feature_gate": null,
      "required_stores": ["feature-specific OAuth stores"],
      "module_capabilities": ["oauth.advanced.v1"],
      "config_keys": ["oauth", "security"],
      "surfaces": ["/par", "/token", "/auth/login"],
      "sources": ["interfaces/sso/server_token.go"]
    },
    {
      "id": "oauth.client-credentials",
      "name": "OAuth client credentials",
      "summary": "Machine-to-machine access-token issuance.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "enabled",
      "feature_gate": null,
      "required_stores": ["ClientStore"],
      "module_capabilities": ["grant.client-credentials.v1"],
      "config_keys": ["clients"],
      "surfaces": ["/token"],
      "sources": ["protocols/oauth/oauthwire/client_creds.go"]
    },
    {
      "id": "oauth.sso",
      "name": "OAuth SSO core",
      "summary": "Authorization Code with PKCE, reusable OP sessions and token issuance.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "enabled",
      "feature_gate": null,
      "required_stores": ["AuthCodeStore", "SessionManager"],
      "module_capabilities": ["oauth.sso-prototype.v1"],
      "config_keys": ["oauth", "clients"],
      "surfaces": ["/auth/login", "/token"],
      "sources": ["cmd/sso-minimal/commands.go"]
    },
    {
      "id": "observability.core",
      "name": "Observability",
      "summary": "Structured logs, traces, metrics, audit events and health probes.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "enabled",
      "feature_gate": null,
      "required_stores": [],
      "module_capabilities": ["observability.host.v1"],
      "config_keys": ["logging", "tracing", "metrics", "audit"],
      "surfaces": ["/livez", "/readyz", "/metrics"],
      "sources": ["platform/metrics"]
    },
    {
      "id": "oidc.core",
      "name": "OpenID Connect core",
      "summary": "Discovery, ID Tokens, UserInfo, session management and logout.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "enabled",
      "feature_gate": "oidc",
      "required_stores": ["IDTokenIssuer"],
      "module_capabilities": ["oidc.common.v1"],
      "config_keys": ["feature_gates.oidc"],
      "surfaces": ["/.well-known/openid-configuration", "/userinfo", "/end_session"],
      "sources": ["protocols/oidc"]
    },
    {
      "id": "payment.stripe",
      "name": "Stripe top-up payment adapter",
      "summary": "Tenant-bound Checkout creation and signed provider-event normalization into Billing payment facts.",
      "availability": ["standalone-binary"],
      "default_state": "disabled",
      "feature_gate": null,
      "required_stores": ["Stripe adapter PostgreSQL inbox", "Snaplink Billing API"],
      "module_capabilities": [],
      "config_keys": ["SNAPLINK_STRIPE_BINDINGS_FILE", "SNAPLINK_STRIPE_LIVE_MODE", "SNAPLINK_STRIPE_ACCOUNT"],
      "surfaces": ["/api/v1/checkout/sessions", "/webhooks/stripe", "/readyz", "/metrics"],
      "sources": ["cmd/snaplink-stripe-adapter"]
    },
    {
      "id": "provisioning.scim",
      "name": "SCIM provisioning",
      "summary": "Inbound SCIM user/group provisioning and optional outbound push.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "disabled",
      "feature_gate": null,
      "required_stores": ["UserProvider"],
      "module_capabilities": ["identity.provisioning.v1"],
      "config_keys": ["scim"],
      "surfaces": ["/api/v1/scim/v2/*"],
      "sources": ["protocols/scim"]
    },
    {
      "id": "storage.production",
      "name": "Production storage backends",
      "summary": "SQLite, PostgreSQL and Redis durable/shared state implementations.",
      "availability": ["stock-binary"],
      "default_state": "conditional",
      "feature_gate": null,
      "required_stores": [],
      "module_capabilities": ["storage.production.v1"],
      "config_keys": ["storage", "postgres", "redis"],
      "surfaces": ["storage SPI"],
      "sources": ["cmd/sso-server/build_stores.go"]
    },
    {
      "id": "tenant.platform",
      "name": "Tenant platform",
      "summary": "Tenant isolation, branding, residency, B2B and usage governance.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "conditional",
      "feature_gate": null,
      "required_stores": ["TenantStore"],
      "module_capabilities": ["platform.tenant.v1"],
      "config_keys": ["tenant", "region", "residency"],
      "surfaces": ["/api/v1/admin/tenants/*", "tenant middleware"],
      "sources": ["domains/tenant"]
    },
    {
      "id": "tenant.quota-projection",
      "name": "Tenant quota projection ingress",
      "summary": "Authenticated monotonic delivery of commercial entitlements into SSO tenant quota enforcement.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "conditional",
      "feature_gate": null,
      "required_stores": ["TenantQuotaProjectionStore"],
      "module_capabilities": ["platform.tenant.v1"],
      "config_keys": ["tenant.resource_quota.backend", "tenant.resource_quota.projection_ingress"],
      "surfaces": ["/api/v1/internal/tenant-quota/projection", "/readyz"],
      "sources": ["domains/tenant/quotabinding", "interfaces/sso/quota.go", "interfaces/ssoclient/quotaprojection"]
    },
    {
      "id": "threat.detection-response",
      "name": "Threat detection and response",
      "summary": "Asynchronous anomaly detection, threat policy and response actions.",
      "availability": ["sdk", "stock-binary"],
      "default_state": "disabled",
      "feature_gate": null,
      "required_stores": ["ThreatPolicyStore", "anomaly stores"],
      "module_capabilities": ["platform.threat.v1"],
      "config_keys": ["anomaly", "token_anomaly", "threat_action"],
      "surfaces": ["/api/v1/admin/threat-policies/*", "/api/v1/admin/tokens/suspicious"],
      "sources": ["domains/threataction"]
    }
  ]
}
