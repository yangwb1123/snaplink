{
  "$schema": "./sdk-surface.schema.json",
  "compatibility": {
    "languages": [
      {
        "file": "docs/sdks/typescript/client.ts",
        "id": "typescript",
        "notes": "fetch-based, zero runtime dependencies; package build and npm provenance publish are gated by the SDK workflows",
        "status": "stable"
      },
      {
        "file": "docs/sdks/python/client.py",
        "id": "python",
        "notes": "stdlib urllib + typing only; zero third-party dependencies",
        "status": "stable"
      }
    ],
    "policy": "Generated clients are additive and semver-tracked. Adding an operation or type never breaks existing call sites; renaming or removing an operationId (the spec's operationId, used verbatim as the method name) is a breaking change requiring a minor-version bump and a CHANGELOG entry. The surface is defined here and validated against docs/openapi.yaml and ops/build/capabilities.json; the generators (cmd/gensdk) never carry their own allowlist."
  },
