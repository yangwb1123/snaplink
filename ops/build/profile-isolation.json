{
  "$schema": "./profile-isolation.schema.json",
  "schema_version": 1,
  "profiles": {
    "billing": {
      "summary": "The billing service owns commerce and usage state without linking either SSO executable composition.",
      "binaries": [
        { "package": "./cmd/snaplink-billing", "binary": "snaplink-billing" }
      ],
      "must_not_link": [
        "cmd/sso-minimal",
        "cmd/sso-server",
        "interfaces/grpcserver",
        "interfaces/snapshot",
        "platform/bootstrap",
        "platform/releases",
        "protocols/scim"
      ],
      "must_link": [
        "domains/metering/usageledger",
        "domains/tenant/commerce",
        "infrastructure/auditgovernance",
        "infrastructure/postgres/tenantcommerce",
        "infrastructure/postgres/usageledger",
        "interfaces/commerce",
        "interfaces/metering",
        "interfaces/ssoclient/quotaprojection",
        "shared/core"
      ]
    },
    "small": {
      "summary": "prototype + minimal editions share one binary (cmd/sso-minimal); the durable/admin/observability graph must stay out.",
      "binaries": [
        { "package": "./cmd/sso-minimal", "binary": "sso-minimal" }
      ],
      "must_not_link": [
        "cmd/sso-server",
        "config/",
        "domains/authenticators/webauthn",
        "domains/connections/sqlite",
        "domains/identitylink/memory",
        "domains/identitylink/sqlite",
        "domains/metering/memory",
        "domains/metering/sqlite",
        "domains/permissions/sqlite",
        "domains/tenant/sqlite",
        "domains/threataction/memory",
        "domains/tokenanomaly/memory",
        "domains/tokenpolicy/memory",
        "domains/userlifecycle/memory",
        "gen/proto",
        "infrastructure/defaultimpl/cryptosigner",
        "infrastructure/defaultimpl/detectors",
        "infrastructure/defaultimpl/emailsmtp",
        "infrastructure/defaultimpl/sqlite",
        "infrastructure/identitylinkpostgres",
        "infrastructure/postgres",
        "infrastructure/redis",
        "infrastructure/sms",
        "interfaces/grpcserver",
        "interfaces/snapshot",
        "interfaces/ssoext",
        "platform/audit/sqlite",
        "platform/bootstrap",
        "platform/cluster/etcd",
        "platform/cluster/memory",
        "platform/configaudit/sqlite",
        "platform/geo/static",
        "platform/lifecycle/operations",
        "platform/netpolicy/etcd",
        "platform/netpolicy/memory",
        "platform/registry",
        "platform/releases",
        "platform/signingkeys/etcd",
        "platform/signingkeys/memory",
        "protocols/scim",
        "shared/security/fipspolicy"
      ],
      "must_link": [
        "domains/authenticators",
        "infrastructure/defaultimpl",
        "interfaces/sso",
        "platform/lifecycle/sessionhub",
        "protocols/oauth",
        "protocols/oidc",
        "shared/core"
      ]
    },
    "full": {
      "summary": "full edition = complete stock composition: durable stores, admin gRPC/gateway, bootstrap, SCIM.",
      "binaries": [
        { "package": "./cmd/sso-server", "binary": "sso-server" }
      ],
      "must_link": [
        "config/",
        "gen/proto",
        "infrastructure/postgres",
        "infrastructure/redis",
        "interfaces/grpcserver",
        "interfaces/snapshot",
        "platform/bootstrap",
        "platform/netpolicy/",
        "protocols/scim"
      ]
    }
  }
}
