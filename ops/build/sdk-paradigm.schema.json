{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "languages"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "package"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "package": { "type": "boolean" },
              "notes": { "type": "string" }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "layer", "parity", "languages"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._][a-z0-9]+)*$" },
          "layer": { "enum": ["transport", "session", "entitlement", "preferences", "runtime"] },
          "summary": { "type": "string", "minLength": 1 },
          "parity": { "enum": ["parity", "divergent"] },
          "languages": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "patternProperties": {
              "^[a-z][a-z0-9]*$": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status"],
                "properties": {
                  "status": { "enum": ["present", "missing"] },
                  "file": { "type": "string", "minLength": 1 },
                  "symbol": { "type": "string", "minLength": 1 },
                  "note": { "type": "string" },
                  "plan": { "type": "string", "minLength": 1 }
                },
                "allOf": [
                  {
                    "if": { "properties": { "status": { "const": "present" } } },
                    "then": { "required": ["file", "symbol"] }
                  },
                  {
                    "if": { "properties": { "status": { "const": "missing" } } },
                    "then": { "required": ["plan"] }
                  }
                ]
              }
            }
          }
        }
      }
    }
  },
  "required": ["$schema", "schema_version", "compatibility", "capabilities"]
}
