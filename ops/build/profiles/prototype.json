{
  "$schema": "../profile.schema.json",
  "schema_version": 1,
  "id": "prototype",
  "summary": "OAuth SSO prototype with structured logs and stable default migration seams.",
  "maturity": "preview",
  "modules": [
    "sso-prototype-runtime"
  ],
  "build": {
    "package": "./cmd/sso-prototype",
    "binary": "snaplink",
    "program": "snaplink",
    "composition_module": "sso-prototype-runtime"
  },
  "policy": {
    "allow_cgo": false,
    "fips": "compatible",
    "allowed_licenses": [
      "Apache-2.0"
    ]
  }
}
