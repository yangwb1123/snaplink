{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDK surface coverage decisions (not a generation allowlist)",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "included_groups", "excluded_groups"],
  "properties": {
    "$schema": {"const": "./sdk-surface-coverage.schema.json", "type": "string"},
    "schema_version": {"const": 1, "type": "integer"},
    "included_groups": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/includedGroup"}
    },
    "excluded_groups": {
      "type": "array",
      "items": {"$ref": "#/$defs/excludedGroup"}
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "references": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "string", "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^:#*?\\\\]+$",
        "description": "Existing repository-local file; resolved containment is also enforced by the checker."
      }
    },
    "includedGroup": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rationale", "exposure", "authentication", "defaults", "licensing", "references"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "rationale": {"$ref": "#/$defs/text"},
        "exposure": {"$ref": "#/$defs/text"},
        "authentication": {"$ref": "#/$defs/text"},
        "defaults": {"$ref": "#/$defs/text"},
        "licensing": {"$ref": "#/$defs/text"},
        "references": {"$ref": "#/$defs/references"}
      }
    },
    "excludedGroup": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rationale", "exposure", "authentication", "defaults", "licensing", "references", "operations"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "rationale": {"$ref": "#/$defs/text"},
        "exposure": {"$ref": "#/$defs/text"},
        "authentication": {"$ref": "#/$defs/text"},
        "defaults": {"$ref": "#/$defs/text"},
        "licensing": {"$ref": "#/$defs/text"},
        "references": {"$ref": "#/$defs/references"},
        "operations": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/operation"}
        }
      }
    },
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "method", "path"],
      "properties": {
        "operationId": {"$ref": "#/$defs/text"},
        "method": {"enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS", "TRACE"], "type": "string"},
        "path": {"type": "string", "minLength": 1, "pattern": "^/"}
      }
    }
  }
}
