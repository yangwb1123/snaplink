{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://snaplink.dev/schemas/build-profile-v1alpha1.json",
  "title": "Snaplink build profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "summary",
    "maturity",
    "modules",
    "policy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "maturity": {
      "enum": [
        "supported",
        "preview",
        "planned"
      ]
    },
    "extends": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "modules": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "package",
        "binary",
        "program",
        "composition_module"
      ],
      "properties": {
        "package": {
          "type": "string",
          "pattern": "^\\./cmd/[A-Za-z0-9._/-]+$"
        },
        "binary": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "program": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "composition_module": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_cgo",
        "fips"
      ],
      "properties": {
        "allow_cgo": {
          "type": "boolean"
        },
        "fips": {
          "enum": [
            "required",
            "compatible",
            "any"
          ]
        },
        "allowed_licenses": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9.+-]*$"
          }
        }
      }
    }
  }
}
