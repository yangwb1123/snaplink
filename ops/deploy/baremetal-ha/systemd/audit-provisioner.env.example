SNAPLINK_AUDIT_PROVISIONER_MANIFEST_FILE=/etc/snaplink/audit-provisioner/desired-state.json
SNAPLINK_AUDIT_PROVISIONER_BASE_URL=https://audit.example.com
SNAPLINK_AUDIT_PROVISIONER_TOKEN_URL=https://sso.example.com/token
SNAPLINK_AUDIT_PROVISIONER_CLIENT_ID=snaplink-audit-provisioner
SNAPLINK_AUDIT_PROVISIONER_CLIENT_SECRET_FILE=/etc/snaplink/secrets/audit-provisioner-client-secret
SNAPLINK_AUDIT_PROVISIONER_RESOURCE=audit-governance
SNAPLINK_AUDIT_PROVISIONER_LISTEN=127.0.0.1:8092
SNAPLINK_AUDIT_PROVISIONER_POLL_INTERVAL=30s
SNAPLINK_AUDIT_PROVISIONER_REQUEST_TIMEOUT=5s
