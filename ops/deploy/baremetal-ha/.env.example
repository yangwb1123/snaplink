# Bare-metal HA reference deployment parameters.
# Copy to .env and replace every change-me-* value before any non-dev use.
# Secrets are injected into sso-server via env overrides, never committed.

# Floating VIP the edge presents (keepalived). On single-host compose this is
# informational; on real VMs it is the live VRRP virtual IP.
SSO_VIP=10.0.0.100
SSO_ISSUER=https://sso.example.com
SSO_PUBLIC_HOST=sso.example.com

# HAProxy expects a combined PEM (certificate chain followed by private key).
# Keep it outside the repository and restrict it to the HAProxy service user.
SSO_TLS_PEM_PATH=/etc/snaplink/secrets/sso-edge.pem
SSO_TLS_CA_PATH=/etc/snaplink/secrets/sso-edge-ca.crt

# Postgres (Patroni superuser/replication + the sso application role)
POSTGRES_SUPER_PASSWORD=change-me-super
SSO_DB_PASSWORD=change-me-sso
BILLING_DB_PASSWORD=change-me-billing
BILLING_AUDIENCE=https://sso.example.com/api/v1/commerce
BILLING_RENEWALS_ENABLED=false
BILLING_AUDIT_BASE_URL=https://audit.example.com
BILLING_AUDIT_CLIENT_ID=snaplink-billing-audit-relay
BILLING_AUDIT_CLIENT_SECRET=change-me-audit-client
BILLING_AUDIT_SOURCE_PREFIX=snaplink-commerce
BILLING_QUOTA_CLIENT_ID=snaplink-billing-quota-relay
BILLING_QUOTA_CLIENT_SECRET=change-me-distinct-quota-client
BILLING_QUOTA_RESOURCE=snaplink-sso-quota
BILLING_RETENTION_CLIENT_ID=snaplink-billing-retention-projector
BILLING_RETENTION_CLIENT_SECRET=change-me-distinct-retention-client
BILLING_RETENTION_RESOURCE=audit-governance

# Stripe adapter (active-active on the two edge hosts). Test-mode placeholders
# are schema-shaped but are not valid production credentials.
STRIPE_DB_PASSWORD=change-me-stripe-db
STRIPE_ADAPTER_AUDIENCE=https://sso.example.com/stripe-adapter
STRIPE_API_VERSION=2025-06-30.basil
STRIPE_WEBHOOK_API_VERSION=2025-06-30.basil
STRIPE_LIVE_MODE=false
STRIPE_ACCOUNT=platform
STRIPE_API_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRETS=whsec_change_me
STRIPE_RETURN_ORIGINS=https://console.example.com
STRIPE_ACME_BILLING_SECRET=change-me-distinct-stripe-billing-client

# Redis Cluster auth (requirepass + masterauth)
SSO_REDIS_PASSWORD=change-me-redis

# etcd client auth (enable auth in production; see RUNBOOK hardening checklist)
ETCD_ROOT_PASSWORD=change-me-etcd

# Image tags (pin in production)
ETCD_TAG=v3.5.16
SPILO_TAG=3.2-p1
REDIS_TAG=7.4-alpine
HAPROXY_TAG=2.9-alpine
KEEPALIVED_TAG=2.0.20
CURL_TAG=8.15.0
