# Shared etcd v3 client environment. Source this (or set ETCDCTL_ENDPOINTS) when
# running etcdctl against the cluster. Patroni and sso-server reach the same
# three endpoints via their own config (patroni.yml / sso config.yaml).
ETCDCTL_API=3
ETCDCTL_ENDPOINTS=http://etcd1:2379,http://etcd2:2379,http://etcd3:2379
