{
  "title": "snaplink/sso — overview",
  "uid": "snaplink-sso-overview",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["snaplink", "sso", "auth"],
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": false, "text": "Prometheus", "value": "Prometheus" }
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(sso_http_requests_total, instance)",
        "includeAll": true,
        "multi": true,
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Overview",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requests / sec (5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(sso_http_requests_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "rps"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 2 } }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Error rate (4xx+5xx, 5m)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(sso_http_requests_total{instance=~\"$instance\",status_class=~\"4xx|5xx\"}[5m])) / sum(rate(sso_http_requests_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "error %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.02 },
              { "color": "red", "value": 0.05 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Login success rate (1h)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "targets": [
        {
          "expr": "sum(rate(sso_login_attempts_total{instance=~\"$instance\",outcome=\"success\"}[1h])) / sum(rate(sso_login_attempts_total{instance=~\"$instance\"}[1h]))",
          "legendFormat": "success %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "green", "value": 0.8 }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active instances",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "targets": [
        {
          "expr": "count(up{job=~\".*sso.*\"} == 1)",
          "legendFormat": "up"
        }
      ]
    },

    {
      "id": 10,
      "type": "row",
      "title": "HTTP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Requests / sec by status class",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "sum by (status_class) (rate(sso_http_requests_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{status_class}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Request duration p95 by method",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(sso_http_request_duration_seconds_bucket{instance=~\"$instance\"}[5m])))",
          "legendFormat": "{{method}} p95"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 20,
      "type": "row",
      "title": "Auth flow",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Login attempts / sec by provider + outcome",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "targets": [
        {
          "expr": "sum by (provider, outcome) (rate(sso_login_attempts_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{provider}} / {{outcome}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Tokens issued / sec by strategy",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 15 },
      "targets": [
        {
          "expr": "sum by (strategy) (rate(sso_tokens_issued_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{strategy}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Risk decisions / sec",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 15 },
      "description": "Zero series when no RiskScorer configured. Spikes in 'deny' indicate the scorer is rejecting attempts.",
      "targets": [
        {
          "expr": "sum by (decision) (rate(sso_risk_decisions_total{instance=~\"$instance\"}[5m]))",
          "legendFormat": "{{decision}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },

    {
      "id": 30,
      "type": "row",
      "title": "Go runtime",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Goroutines",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 24 },
      "targets": [
        {
          "expr": "go_goroutines{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Heap allocated",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 24 },
      "targets": [
        {
          "expr": "go_memstats_alloc_bytes{instance=~\"$instance\"}",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "GC pause p99",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 24 },
      "targets": [
        {
          "expr": "go_gc_duration_seconds{instance=~\"$instance\",quantile=\"1\"}",
          "legendFormat": "{{instance}} max"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" } }
    },

    {
      "id": 40,
      "type": "row",
      "title": "Audit pipeline & signing health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Audit async drops / sec by cause",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 33 },
      "description": "Any non-zero series is silent audit-trail loss - the async sink is fail-open by design (SSOAuditEventsDropped alert).",
      "targets": [
        { "expr": "sum(rate(sso_audit_async_drops_queue_full_total{instance=~\"$instance\"}[5m]))", "legendFormat": "queue_full" },
        { "expr": "sum(rate(sso_audit_async_drops_closed_total{instance=~\"$instance\"}[5m]))", "legendFormat": "closed" },
        { "expr": "sum(rate(sso_audit_async_drops_inner_error_total{instance=~\"$instance\"}[5m]))", "legendFormat": "inner_error" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops" } }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Audit queue fill ratio",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 33 },
      "description": "sso_audit_async_queue_depth / capacity per instance. Drops begin at 1.0; alert fires at 0.8.",
      "targets": [
        { "expr": "sso_audit_async_queue_depth{instance=~\"$instance\"} / sso_audit_async_queue_capacity{instance=~\"$instance\"}", "legendFormat": "{{instance}}" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 0.8 }
            ]
          }
        }
      }
    },
    {
      "id": 43,
      "type": "timeseries",
      "title": "Signing health (KMS backend + key aggregation)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 33 },
      "description": "Gauges sit at 1 when healthy; no series when no external signer / registry is wired. Adoption errors indicate a peer publishing bad keys.",
      "targets": [
        { "expr": "min by (alg) (sso_signing_backend_up{instance=~\"$instance\"})", "legendFormat": "backend up {{alg}}" },
        { "expr": "min(sso_signing_key_aggregation_up{instance=~\"$instance\"})", "legendFormat": "aggregation up" },
        { "expr": "sum by (reason) (rate(sso_signing_key_adoption_errors_total{instance=~\"$instance\"}[5m]))", "legendFormat": "adoption errors {{reason}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "short" } }
    }
  ]
}
