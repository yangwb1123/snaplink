{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": { "type": "integer", "const": 1 },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": { "port": { "type": "integer", "minimum": 1, "maximum": 65535 } }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auditBaseURL", "tokenURL", "clientID", "resource", "pollInterval", "requestTimeout", "existingSecret", "secretKey", "existingDesiredConfigMap", "allowInsecureLoopback"],
      "properties": {
        "auditBaseURL": { "type": "string", "pattern": "^https://" },
        "tokenURL": { "type": "string", "pattern": "^https://" },
        "clientID": { "type": "string", "minLength": 1 },
        "resource": { "type": "string", "minLength": 1 },
        "pollInterval": { "type": "string", "minLength": 2 },
        "requestTimeout": { "type": "string", "minLength": 2 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "secretKey": { "type": "string", "minLength": 1 },
        "existingDesiredConfigMap": { "type": "string", "minLength": 1 },
        "allowInsecureLoopback": { "type": "boolean", "const": false }
      }
    },
    "desiredState": { "type": "string" },
    "resources": { "type": "object" }
  },
  "required": ["replicaCount", "image", "serviceAccount", "service", "config", "desiredState", "resources"]
}
