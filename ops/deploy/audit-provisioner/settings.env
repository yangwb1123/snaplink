SNAPLINK_AUDIT_PROVISIONER_MANIFEST_FILE=/etc/snaplink-audit-provisioner/desired/..data/desired-state.json
SNAPLINK_AUDIT_PROVISIONER_BASE_URL=https://audit-governance.snaplink-audit.svc.cluster.local:8089
SNAPLINK_AUDIT_PROVISIONER_TOKEN_URL=https://sso-server.snaplink-sso.svc.cluster.local:8080/token
SNAPLINK_AUDIT_PROVISIONER_CLIENT_ID=snaplink-audit-provisioner
SNAPLINK_AUDIT_PROVISIONER_CLIENT_SECRET_FILE=/etc/snaplink-audit-provisioner/secret/..data/client-secret
SNAPLINK_AUDIT_PROVISIONER_RESOURCE=audit-governance
SNAPLINK_AUDIT_PROVISIONER_LISTEN=:8092
SNAPLINK_AUDIT_PROVISIONER_POLL_INTERVAL=30s
SNAPLINK_AUDIT_PROVISIONER_REQUEST_TIMEOUT=5s
