proxy_pass http://sso_backend;
proxy_http_version 1.1;
proxy_set_header Connection $connection_upgrade;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header X-Forwarded-Proto $gateway_proto;
proxy_set_header X-Request-ID $gateway_request_id;
proxy_set_header X-Snaplink-Surface $gateway_surface;
proxy_set_header X-Auth-Subject "";
proxy_set_header X-Auth-Audience "";
proxy_set_header X-Auth-Scopes "";
proxy_set_header X-Auth-Tenant "";
proxy_set_header X-Network "";
proxy_connect_timeout 5s;
proxy_read_timeout 60s;
proxy_send_timeout 60s;
