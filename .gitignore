# Built binaries (Go produces these at module root and cmd/*; the
# Makefile builds into /bin; goreleaser snapshot output lands in /dist).
/sso-server
/sso-audit-verify
/sso-snapshotctl
/sso-migrate
/cmd/sso-server/sso-server
/cmd/sso-audit-verify/sso-audit-verify
/cmd/sso-snapshotctl/sso-snapshotctl
/cmd/sso-migrate/sso-migrate
/cmd/sso-mcp/sso-mcp
/bin/
/dist/

# air (github.com/air-verse/air) hot-reload build output — see .air.toml /
# `make dev`. Not a go.mod dependency, just a local dev-loop artifact dir.
/tmp/

# Editor / OS noise
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Local test artifacts
*.log
*.out
coverage.out
# Bootstrap-state ledger written by the server at runtime (default path); a
# per-deployment artifact regenerated on boot, never source.
/bootstrap.json

# Claude Code session state
.claude/

# stray binary from `go build -o playground ./examples/playground`
/playground

# Legacy generated check scripts (replaced by checks/*.py)
/.check-*.sh

# Agent OS Markdown under docs/agent-os/ is source-controlled. The engineering
# generator verifies those documents exist and must not overwrite them.
__pycache__/
.pytest_cache/
# Trend snapshots emitted by ops/scripts/trend.py — local tooling output,
# regenerated per run (also skipped by the maintainability fan-out gates).
.trends/

# AI-SDLC exploratory Markdown. Promote verified conclusions into maintained
# docs explicitly instead of committing generated review corpora.
/docs/results/
/docs/requirements/*.out.md
/ai-dev/ai/reviews/

# Compiled binaries (root-anchored: the build output dir /bin/ is ignored
# above; these leading-slash patterns catch a stray `go build` at the repo
# root WITHOUT matching the cmd/sso-server source directory — a bare
# `sso-server` pattern previously ignored the entire cmd/sso-server/ package).
/sso-server
/sso-ctl
/sso-audit-verify
/sso-migrate
/sso-snapshotctl
/sso-import
