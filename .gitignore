/sso-server
/sso-audit-verify
/sso-snapshotctl
/sso-migrate
/cmd/sso-server/sso-server
/cmd/sso-audit-verify/sso-audit-verify
/cmd/sso-snapshotctl/sso-snapshotctl
/cmd/sso-migrate/sso-migrate
/bin/
/dist/

# Editor / OS noise
.DS_Store
*.swp
*.swo
.idea/
.vscode/

# Local test artifacts
*.log
*.out
coverage.out

# Claude Code session state
.claude/

# stray binary from `go build -o playground ./examples/playground`
/playground

# Harness-engineering scaffolding regenerated by `make harness` (NOT part of the
# repo; `make ci` runs `make harness`, which writes these into the tree). Ignored
# so they can never be accidentally committed.
/.check-*.sh
/.githooks/
/CHECKS_REGISTRY.md
/HARNESS.md
/ARCHITECTURE.md
/BOOTSTRAP.md
