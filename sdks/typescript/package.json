{
  "name": "@snaplink/sso",
  "version": "0.4.0",
  "description": "TypeScript SDK for the snaplink/sso HTTP API and hosted-login redirects.",
  "author": "Snaplink contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yangwb1123/snaplink.git",
    "directory": "sdks/typescript"
  },
  "bugs": {
    "url": "https://github.com/yangwb1123/snaplink/issues"
  },
  "homepage": "https://github.com/yangwb1123/snaplink/tree/main/docs/sdks/typescript",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test *.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "browser-login.ts",
    "client.ts",
    "entitlement.ts",
    "hosted-login.ts",
    "index.ts",
    "jwks.ts",
    "license-file.ts",
    "preferences.ts",
    "resource-server.ts",
    "server-login.ts"
  ]
}
